# New Firebase Configuration Template
# Replace these values with your new Firebase project credentials

FIREBASE_API_KEY="YOUR_NEW_API_KEY_HERE"
FIREBASE_PROJECT_ID="YOUR_NEW_PROJECT_ID_HERE"
FIREBASE_APP_ID="YOUR_NEW_APP_ID_HERE"
FIREBASE_STORAGE_BUCKET="YOUR_NEW_PROJECT_ID.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="YOUR_NEW_SENDER_ID_HERE"

# Keep existing PostgreSQL configuration
POSTGRES_DB=quickaid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Instructions:
# 1. Create new Firebase project at https://console.firebase.google.com
# 2. Go to Project Settings → General → Your apps
# 3. Add Android app or use existing web app config
# 4. Copy the config values and replace the placeholders above
# 5. Rename this file to .env (backup current .env first)
